<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <Description>Elsa Workflows 3 agent definitions on Aster: an IAgentStore for Elsa's agent persistence feature that saves every update as an Aster resource version and reads the version active in a channel, plus a one-time import from Elsa's own agent store. Supports Elsa 3.9 and later 3.x releases.</Description>
    <PackageTags>aster;elsa;elsa-workflows;agents;versioning</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- CI builds and tests against the lower bound of the supported range (docs/consumers/elsa-module-design.md). -->
    <PackageReference Include="Elsa.Agents.Persistence" Version="[3.9.0, 4.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aster.Elsa\Aster.Elsa.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aster.Elsa.Agents.Tests" />
  </ItemGroup>

</Project>
